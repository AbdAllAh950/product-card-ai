# Скопируйте в .env и заполните. Файл .env в .gitignore — ключи не попадают в репозиторий.
# Подходит любой OpenAI-совместимый API: меняются только адрес, модель и ключ.

# --- YandexGPT (Yandex AI Studio) ---
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_PROJECT=<id_каталога>
LLM_MODEL=gpt://<id_каталога>/yandexgpt/latest

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# --- DeepSeek ---
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat

# --- Локальная модель через Ollama (ключ не нужен) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# Необязательные параметры
# LLM_TEMPERATURE=0.2      # низкая температура — меньше «фантазии»
# LLM_TIMEOUT=60           # секунд на один запрос
# LLM_MAX_RETRIES=2        # повторы при 429/5xx и сетевых ошибках
# LLM_JSON_MODE=1          # response_format=json_object; 0 — если провайдер не поддерживает
# LLM_AUTH_SCHEME=Bearer   # для Yandex AI Studio можно указать Api-Key
